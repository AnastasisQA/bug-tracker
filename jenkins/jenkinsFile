pipeline {
    agent any

    stages {
        stage('UNIT TESTS BACK END') {
            
                agent {
                    docker{
                        image 'snakee/golang-junit:1.21'
                        reuseNode true
                    }
                }

                environment {
                    // Container runs as uid 1000 with HOME=/, so point Go's
                    // cache and module dirs at the writable workspace.
                    HOME       = "${WORKSPACE}"
                    GOCACHE    = "${WORKSPACE}/.cache/go-build"
                    GOPATH     = "${WORKSPACE}/.go"
                }

                steps {
                    dir('bugtracker-backend'){
                        sh 'go test -v ./...'
                    }
               }
            }
            stage('UNIT TESTS Frontend') {
            agent {
                    docker{
                        image 'node:20-alpine'
                        reuseNode true
                    }
                }
            steps {
                    dir('bugtracker-frontend'){
                        sh '''
                            npm ci
                            npm test
                        '''
                    }
               }
            }
            stage('Lanch Application') {
                agent {
                    docker {
                        image 'docker:27.5.1'
                        reuse true
                        args '-v/vat/run/docker.sock:/var/run/docker.sock -u 0'
                    }
                }
                steps {
                    sh 'docker compose up --build -d'
                }
            }

          //  post {
         //       always {
         //           junit 'bugtracker-frontend/test-results.xml'
          //      }
          //  }

         }
        
         
    }
